# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ZEGOCLOUD Configuration for Video/Voice Calling and Screen Sharing
VITE_ZEGOCLOUD_APP_ID="1484647939"
VITE_ZEGOCLOUD_SERVER_SECRET="4068ef573678dc2fbb5591cfc24cb349"

# Supabase Storage Configuration (photos bucket)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Firebase Project Configuration (Project: meet-up-new)
# 1. Project ID (e.g. meet-up-new)
VITE_FIREBASE_PROJECT_ID="meet-up-new"
# 2. Auth Domain (e.g. meet-up-new.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN="meet-up-new.firebaseapp.com"
# 3. Web API Key (Starts with AIzaSy...)
VITE_FIREBASE_API_KEY="AIzaSyAy6jb-oJyGTZRPU_TWIDjaU-I9DkifteE"
# 4. Storage Bucket (Optional, e.g. meet-up-new.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET="meet-up-new.firebasestorage.app"
# 5. Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID="907800317253"
# 6. App ID
VITE_FIREBASE_APP_ID="1:907800317253:web:1550307fe7efd776b5422c"
