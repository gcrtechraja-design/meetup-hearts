# ==============================================================================
# REMIX REMIX MEET UP - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your credentials.
# All values below are left empty for production setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & AI STUDIO RUNTIME
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# Where to get: Google AI Studio Console -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# APP_URL: The public canonical URL where this app is hosted (used for push notifications & redirects).
# Where to get: Your deployed domain or Cloud Run service URL (e.g., https://your-domain.com)
APP_URL=""

# PORT: Server listening port for Express backend (defaults to 3000)
PORT="3000"

# NODE_ENV: Application environment mode (development or production)
NODE_ENV="production"


# ------------------------------------------------------------------------------
# 2. FIREBASE CONFIGURATION
# Where to get: Firebase Console -> Project Settings -> General -> Your apps -> Web app config
# URL: https://console.firebase.google.com/project/_/settings/general/
# ------------------------------------------------------------------------------
# Firebase Project ID (e.g. meet-up-new)
VITE_FIREBASE_PROJECT_ID=""

# Firebase Web API Key (Starts with AIzaSy...)
VITE_FIREBASE_API_KEY=""

# Firebase Auth Domain (e.g. your-project.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=""

# Firebase Storage Bucket (e.g. your-project.firebasestorage.app)
VITE_FIREBASE_STORAGE_BUCKET=""

# Firebase Messaging Sender ID (Numeric sender ID, e.g. 907800317253)
# Where to get: Firebase Console -> Project Settings -> Cloud Messaging -> Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Firebase Web App ID (e.g. 1:907800317253:web:1550307fe7efd776b5422c)
VITE_FIREBASE_APP_ID=""


# ------------------------------------------------------------------------------
# 3. ZEGOCLOUD AUDIO & VIDEO CALLING
# Where to get: ZEGOCLOUD Admin Console -> Project Management -> Project Details
# URL: https://console.zegocloud.com/
# ------------------------------------------------------------------------------
# ZEGOCLOUD App ID (Numeric App ID provided by ZEGOCLOUD)
VITE_ZEGOCLOUD_APP_ID=""

# ZEGOCLOUD Server Secret (32-character hex secret string)
VITE_ZEGOCLOUD_SERVER_SECRET=""


# ------------------------------------------------------------------------------
# 4. SUPABASE STORAGE & SYNC (OPTIONAL)
# Where to get: Supabase Dashboard -> Project Settings -> API
# URL: https://supabase.com/dashboard/project/_/settings/api
# ------------------------------------------------------------------------------
# Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=""
SUPABASE_URL=""

# Project API Anon Key (Public key, starts with eyJhbGci...)
VITE_SUPABASE_ANON_KEY=""
SUPABASE_ANON_KEY=""
