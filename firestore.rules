rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'rajasuvimarriage09@gmail.com' ||
        request.auth.token.email == 'gcrtech.raja@gmail.com' ||
        request.auth.token.email == 'admin@meetup.com' ||
        request.auth.token.email == 'mrraavana07@gmail.com'
      );
    }

    // 1. Users collection
    // Allow public read for profile cards & listener discovery.
    // Allow authenticated users to create and update their own user documents.
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAdmin() || 
                               (isAuthenticated() && request.auth.uid == userId) || 
                               userId.matches('^listener_seed_[0-9]+$') || 
                               userId.matches('^real_listener_[0-9]+$') || 
                               userId.matches('^admin_.*') ||
                               userId.matches('^phone_.*') ||
                               userId.matches('^demo_.*');
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);

      // Subcollections under users (e.g. notifications, settings, etc.)
      match /{subcollection=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // 2. Transactions collection
    match /transactions/{txId} {
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId || 
        request.auth.uid == request.resource.data.user_id
      );
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || 
        request.auth.uid == resource.data.user_id || 
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 3. Settings collection (e.g. UPI ID payment_config)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Calls & In-Call Signaling / Messages Subcollections
    match /calls/{callId} {
      allow read, write: if isAuthenticated();

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 5. Call Logs
    match /call_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Reports & Moderation
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // 7. Blocks & Blacklists
    match /blocks/{blockId} {
      allow read, write: if isAuthenticated();
    }

    match /blocked_users/{blockId} {
      allow read, write: if isAuthenticated();
    }

    // 8. Favourites & Bookmarks
    match /user_favourites/{favId} {
      allow read, write: if isAuthenticated();
    }

    match /bookmarks/{bookmarkId} {
      allow read, write: if isAuthenticated();
    }

    // 9. Listener Applications & Listeners collection
    match /listener_applications/{appId} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    match /listeners/{listenerId} {
      allow read, write: if true;
    }

    // 10. Mutual Matches & Direct Messages
    match /matches/{matchId} {
      allow read, write: if isAuthenticated();

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    match /direct_chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}
